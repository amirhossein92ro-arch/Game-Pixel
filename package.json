{
  "name": "web2-gaming-store",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack demo gaming store built with Node.js and Express",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "verify:products": "node scripts/verify-products.cjs",
    "backup": "node scripts/backup.cjs"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "express": "^4.22.2",
    "helmet": "^8.3.0"
  },
  "keywords": [
    "gaming-store",
    "express",
    "nodejs"
  ],
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^30.1.1"
  }
}
