# محیط اجرا
NODE_ENV=development
PORT=5000

# مبدأ فرانت‌اند برای CORS (می‌تواند چند مقدار با ویرگول باشد)
CLIENT_URL=http://localhost:3000

# اتصال به MongoDB
# محلی:  mongodb://127.0.0.1:27017/gaming_store
# Atlas: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/gaming_store
MONGODB_URI=mongodb://127.0.0.1:27017/gaming_store

# JWT
JWT_SECRET=please_change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ساخت ادمین اولیه با: npm run seed
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@gamingstore.test
ADMIN_PASSWORD=ChangeMe123!

# درگاه پرداخت — فعلاً غیرفعال و فقط ساختار آماده
PAYMENT_ENABLED=false
ZARINPAL_MERCHANT_ID=
PAYMENT_CALLBACK_URL=http://localhost:5000/api/payments/verify
