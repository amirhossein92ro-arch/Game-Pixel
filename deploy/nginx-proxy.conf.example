# Include from each WEB 2 proxy location. There is no WebSocket endpoint.
# Install nginx-upstream.conf.example in the http context first.
limit_req zone=web2_requests burst=180 nodelay;
proxy_pass http://web2_backend;
proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
# Replace client-supplied forwarding headers instead of appending to them.
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host $host;
proxy_set_header Connection "";
proxy_connect_timeout 5s;
proxy_read_timeout 30s;
proxy_send_timeout 30s;
