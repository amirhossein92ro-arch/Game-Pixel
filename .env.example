# Copy to .env; never commit .env. Choose your own password, 12-72 UTF-8 bytes.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
# First-party, anonymous journey counts. Raw events expire after the configured days.
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90
# Also supplies canonical, sitemap and social URLs. Set the real HTTPS production
# origin before release; request Host/X-Forwarded-Host never determine SEO URLs.
# Comma-separated exact origins permitted to call the API.
# Production origins must use HTTPS, for example https://shop.example.com.
# Whitespace and a trailing slash are normalized; do not include paths or use '*'.
ALLOWED_ORIGINS=
# Trust addresses only, never true/1. For Nginx on the same host use loopback.
TRUST_PROXY=
# HTTPS rollout: leave HSTS disabled until TLS, redirects and renewal are stable.
# Then start with 300 seconds. No includeSubDomains or preload is emitted.
HSTS_MAX_AGE=0
# Optional Live Server development only. Use the same hostname for frontend/backend.
DEV_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional bootstrap Super Admin 2FA: supply your own Base32 authenticator secret.
# Never put this value in frontend code. Removing it later fails closed.
ADMIN_TOTP_SECRET=
# Required to enable customer authenticator 2FA. Generate 32 random bytes as hex,
# keep the same key across restarts and backups. Leave blank until configured.
ACCOUNT_TOTP_KEY=
STORE_TIMEZONE=Asia/Tehran
# The active application already uses SQLite. Switching is explicit; JSON is an offline legacy source.
STORAGE_DRIVER=sqlite
# SQLITE_PATH=/srv/web2/var/web2.sqlite
# DATABASE_PATH remains a compatible alias; conflicting paths fail closed.
# DATABASE_PATH=/srv/web2/var/web2.sqlite
# PostgreSQL is a future adapter, not a usable runtime choice yet. Never commit credentials.
# DATABASE_URL=postgresql://...
# Operations (backups are private and outside the application tree).
# BACKUP_DIR=/var/backups/web2
# BACKUP_DAILY_DAYS=7
# BACKUP_WEEKLY_WEEKS=4
# BACKUP_MIN_FREE_MB=512
# BACKUP_MAX_SIZE_MB=2048
# DISK_WARN_PERCENT=80
# DISK_CRITICAL_PERCENT=90
# NGINX_HEALTH_URL=https://shop.example.com/health
# OPS_ALERT_HOOK=/usr/local/bin/web2-alert
PAYMENT_MODE=test
# Official provider adapter is not implemented; non-test mode fails closed.
# PAYMENT_PROVIDER/PAYMENT_API_KEY/PAYMENT_CALLBACK_URL and SMTP_* are unused.
# Configuring them cannot enable real payments or email.
# Use "kavenegar" for the built-in real adapter, "generic" for a JSON API, or leave empty for development mock.
# Production without SMS starts with a warning; OTP delivery remains unavailable.
SMS_PROVIDER=
SMS_API_KEY=
# Only required for SMS_PROVIDER=generic.
SMS_API_URL=
SMS_SENDER=
SMS_TEMPLATE_ID=
# OTP validity is clamped to 2-5 minutes. Mock SMS is used only outside production.
OTP_TTL_MINUTES=2
# Cloudflare Turnstile: site key is public; secret key stays on the server. Both are mandatory in production.
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
