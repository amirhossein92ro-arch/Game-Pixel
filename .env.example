# Copy to .env; never commit .env. Choose your own password, 12-72 UTF-8 bytes.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
# Optional Live Server development only. Use the same hostname for frontend/backend.
DEV_FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Explicit exception for ADMIN_PASSWORD=12345 in development/test only.
DEV_ADMIN_PASSWORD_ENABLED=false
# Optional bootstrap Super Admin 2FA: supply your own Base32 authenticator secret.
# Never put this value in frontend code. Removing it later fails closed.
ADMIN_TOTP_SECRET=
STORE_TIMEZONE=Asia/Tehran
# DATABASE_PATH=G:/web 2/var/web2.sqlite
PAYMENT_MODE=test
# Official provider adapter is not implemented; non-test mode fails closed.
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_CALLBACK_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SMS_PROVIDER=
SMS_API_KEY=
