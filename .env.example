# Copy to .env; never commit .env. Choose your own password, 12-72 UTF-8 bytes.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:3000
# Keep false for HTTPS deployments. Set true only when production must run directly over HTTP.
ALLOW_PRODUCTION_HTTP=false
# Comma-separated exact origins permitted to call the API.
# HTTP deployment example: http://203.0.113.10:3000,http://203.0.113.10
# Whitespace and a trailing slash are normalized; do not include paths or use '*'.
ALLOWED_ORIGINS=
# Set to 1/true only when one trusted reverse proxy (for example Nginx) is in front of Express.
TRUST_PROXY=
# Optional Live Server development only. Use the same hostname for frontend/backend.
DEV_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Explicit exception for ADMIN_PASSWORD=12345 in development/test only.
DEV_ADMIN_PASSWORD_ENABLED=false
# Optional bootstrap Super Admin 2FA: supply your own Base32 authenticator secret.
# Never put this value in frontend code. Removing it later fails closed.
ADMIN_TOTP_SECRET=
STORE_TIMEZONE=Asia/Tehran
# DATABASE_PATH=G:/web 2/var/web2.sqlite
PAYMENT_MODE=test
# Official provider adapter is not implemented; non-test mode fails closed.
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_CALLBACK_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Use "kavenegar" for the built-in real adapter, "generic" for a JSON API, or leave empty for development mock.
SMS_PROVIDER=
SMS_API_KEY=
# Only required for SMS_PROVIDER=generic.
SMS_API_URL=
SMS_SENDER=
SMS_TEMPLATE_ID=
# OTP validity is clamped to 2-5 minutes. Mock SMS is used only outside production.
OTP_TTL_MINUTES=2
# Cloudflare Turnstile: site key is public; secret key stays on the server. Both are mandatory in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
